:Step11_BlockTelemetry
echo %white%[11/12]%u% %c%Blocking Telemetry Hosts...%u%

call :CheckAdmin
if errorlevel 1 (
    echo %orange%  ! Administrator privileges required to modify hosts file%u%
    echo.
    exit /b
)

setlocal
set "HOSTS=%windir%\System32\drivers\etc\hosts"
set "TMPHOSTS=%TEMP%\hosts_current.tmp"
set "NEWHOSTS=%TEMP%\hosts_new.tmp"
set "blockedCount=0"

if exist "%NEWHOSTS%" del "%NEWHOSTS%" >nul 2>&1
if exist "%TMPHOSTS%" del "%TMPHOSTS%" >nul 2>&1

attrib -r -s -h "%HOSTS%" >nul 2>&1

if exist "%HOSTS%" (
    copy /Y "%HOSTS%" "%TMPHOSTS%" >nul 2>&1
) else (
    type NUL > "%HOSTS%" 2>nul
    type NUL > "%TMPHOSTS%" 2>nul
)

for %%H in (
    telemetry.gfe.nvidia.com
    events.gfe.nvidia.com
    telemetry-web.gfe.nvidia.com
    rds-assets.nvidia.com
) do (
    findstr /I /C:"%%H" "%TMPHOSTS%" >nul 2>&1 || (
        echo 127.0.0.1 %%H>>"%NEWHOSTS%"
        echo %green%  ✓ Queued telemetry block: %%H%u%
        set /a "blockedCount+=1"
    )
)

if "%DISABLE_NVIDIA_APP%"=="true" (
    for %%H in (
        gfwsl.geforce.com
        services.gfe.nvidia.com
        accounts.nvgs.nvidia.com
    ) do (
        findstr /I /C:"%%H" "%TMPHOSTS%" >nul 2>&1 || (
            echo 127.0.0.1 %%H>>"%NEWHOSTS%"
            echo %green%  ✓ Queued app host block: %%H%u%
            set /a "blockedCount+=1"
        )
    )
) else (

:ShaderCacheCleaner
cls
call :SetupConsole
echo.
echo.
echo %c%╔═══════════════════════════════════════════════════════════════════════════════╗
echo ║                   GPU SHADER CACHE PURGE ^& REBUILD UTILITY                       ║
echo ╚═══════════════════════════════════════════════════════════════════════════════╝%u%
echo.
echo %c%Stale, corrupt, or bloated shader caches are the #1 cause of sudden stuttering%u%
echo %c%and frame pacing drops after GPU driver updates or major game patches.%u%
echo.
echo %c%This tool safely purges compiled shader caches across all major architectures:%u%
echo %c%  • NVIDIA: DXCache, GLCache, NV_Cache, ComputeCache, PerDriverVersion%u%
echo %c%  • AMD:    DxCache, DX9Cache, DxcCache, OglCache%u%
echo %c%  • Intel:  ShaderCache%u%
echo %c%  • DirectX: D3DSCache [system Direct3D runtime cache]%u%
echo %c%  • Steam:  Per-game pre-compiled shader cache%u%
echo.
echo %orange%Note: Games and GPU control panels should be closed before proceeding.%u%
echo %c%Games will cleanly recompile fresh, optimized shaders on next launch.%u%
echo.
choice /C YN /M "%c%Proceed with full GPU Shader Cache purge? [Y/N]%u%"

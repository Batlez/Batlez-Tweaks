)

if "%DISABLE_UPDATES%"=="true" (
    for %%H in (
        ota-downloads.nvidia.com
    ) do (
        findstr /I /C:"%%H" "%TMPHOSTS%" >nul 2>&1 || (
            echo 127.0.0.1 %%H>>"%NEWHOSTS%"
            echo %green%  ✓ Queued update host block: %%H%u%
            set /a "blockedCount+=1"
        )
    )
) else (
    echo %c%  • NVIDIA driver update hosts preserved%u%
)

if exist "%NEWHOSTS%" (
    type "%NEWHOSTS%" >> "%HOSTS%" 2>nul
    if !errorlevel! neq 0 (
        timeout /t 1 >nul
        type "%NEWHOSTS%" >> "%HOSTS%" 2>nul
    )
    echo %green%  ✓ Telemetry host^(s^) added to hosts file%u%
    ipconfig /flushdns >nul 2>&1
    del "%NEWHOSTS%" >nul 2>&1
) else (
    echo %c%  • Telemetry hosts already configured%u%
)

if exist "%TMPHOSTS%" del "%TMPHOSTS%" >nul 2>&1
echo.
endlocal & exit /b


:DisableService
setlocal enabledelayedexpansion
set "serviceName=%~1"
if /i "!serviceName!"=="msiserver" (
    sc config "msiserver" start= demand >nul 2>&1
    reg add "HKLM\SYSTEM\CurrentControlSet\Services\msiserver" /v "Start" /t REG_DWORD /d 3 /f >nul 2>&1
    echo %green%    → Preserved Manual ^(On-Demand^): !serviceName!%u%
    exit /b
)
reg query "HKLM\SYSTEM\CurrentControlSet\Services\!serviceName!" /v "Start" 2>nul | findstr /i "0x4" >nul
if !errorlevel! equ 0 (
    echo %green%    → Disabled: !serviceName!%u%
    exit /b
)
sc query "!serviceName!" >nul 2>&1
if !errorlevel! neq 0 (
    reg query "HKLM\SYSTEM\CurrentControlSet\Services\!serviceName!" >nul 2>&1
    if !errorlevel! neq 0 (
        echo %yellow%    → Not found: !serviceName!%u%
        exit /b
    )
)
sc config "!serviceName!" start= disabled >nul 2>&1
if !errorlevel! equ 0 (
    echo %green%    → Disabled: !serviceName!%u%
    exit /b
)
reg add "HKLM\SYSTEM\CurrentControlSet\Services\!serviceName!" /v "Start" /t REG_DWORD /d "4" /f >nul 2>&1
if !errorlevel! equ 0 (
    echo %green%    → Disabled: !serviceName!%u%
    exit /b
)
reg query "HKLM\SYSTEM\CurrentControlSet\Services\!serviceName!" /v "Start" 2>nul | findstr /i "0x4" >nul
if !errorlevel! equ 0 (
    echo %green%    → Disabled: !serviceName!%u%
    exit /b
)
if /i "!serviceName!"=="wscsvc" (
    echo %yellow%    → Protected by Windows Security: !serviceName!%u%
    exit /b
)
if /i "!serviceName!"=="msiserver" (
    echo %green%    → Set to Manual ^(On-Demand^): !serviceName!%u%
    exit /b
)
if /i "!serviceName!"=="BluetoothUserService" (
    echo %green%    → Disabled ^(Template^): !serviceName!%u%
    exit /b
)
echo %red%    → Failed: !serviceName!%u%
exit /b

:DisableServiceWildcard
setlocal enabledelayedexpansion
set "servicePattern=%1"
for /f "skip=1 tokens=2" %%s in ('sc query type= service state= all ^| findstr "SERVICE_NAME"') do (
    echo %%s | findstr /i "!servicePattern!" >nul && (
        sc config "%%s" start= disabled >nul 2>&1
        if !errorlevel! equ 0 (
            echo %green%    → Disabled wildcard: %%s%u%
        )
    )
)
exit /b


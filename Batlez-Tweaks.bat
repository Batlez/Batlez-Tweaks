echo.
echo %c%╔══════════════════════════════════════════════════════════════════════════════╗
echo ║                          STREAM OPTIMIZER                                    ║
echo ╚══════════════════════════════════════════════════════════════════════════════╝%u%
echo.
echo %c%Optimizes your system for gaming while live streaming:%u%
echo %c%• Sets process priority: game High, streaming tools Normal/BelowNormal%u%

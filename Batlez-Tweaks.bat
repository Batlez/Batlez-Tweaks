for /f "tokens=3" %%v in ('reg query "HKCU\Software\Policies\Microsoft\Windows\CurrentVersion\PushNotifications" /v "NoToastApplicationNotification" 2^>nul') do (
    if "%%v"=="0x1" set "NOTIF_STATUS=%red%DISABLED (Quiet Mode)%u%"

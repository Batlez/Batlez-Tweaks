set "NOTIF_STATUS=%green%ENABLED (Default)%u%"
for /f "tokens=3" %%v in ('reg query "HKCU\Software\Microsoft\Windows\CurrentVersion\PushNotifications" /v "ToastEnabled" 2^>nul') do (
    if "%%v"=="0x0" set "NOTIF_STATUS=%red%DISABLED (Quiet Mode)%u%"

:DoPurgeShaderCaches
echo.
echo %c%[1/5] Purging NVIDIA Shader Caches...%u%
for %%D in (
    "%PROGRAMDATA%\NVIDIA Corporation\NV_Cache"
    "%LOCALAPPDATA%\NVIDIA\GLCache"
    "%LOCALAPPDATA%\NVIDIA\DXCache"
    "%APPDATA%\NVIDIA\ComputeCache"
    "%USERPROFILE%\AppData\LocalLow\NVIDIA\PerDriverVersion\DXCache"
    "%USERPROFILE%\AppData\LocalLow\NVIDIA\DXCache"
    "%USERPROFILE%\AppData\LocalLow\NVIDIA\PerDriverVersion\GLCache"
) do (
    if exist "%%~D" (
        del /s /f /q "%%~D\*.*" >nul 2>&1
        for /d %%p in ("%%~D\*") do rd /s /q "%%p" >nul 2>&1
        echo %green%  [+] Purged: %%~D%u%
    )
)

echo.
echo %c%[2/5] Purging AMD Radeon Shader Caches...%u%
for %%D in (
    "%LOCALAPPDATA%\AMD\DxCache"
    "%LOCALAPPDATA%\AMD\DX9Cache"
    "%LOCALAPPDATA%\AMD\DxcCache"
    "%LOCALAPPDATA%\OglCache"
) do (
    if exist "%%~D" (
        del /s /f /q "%%~D\*.*" >nul 2>&1
        for /d %%p in ("%%~D\*") do rd /s /q "%%p" >nul 2>&1
        echo %green%  [+] Purged: %%~D%u%
    )
)

echo.
echo %c%[3/5] Purging Intel GPU Shader Caches...%u%
if exist "%LOCALAPPDATA%\Intel\ShaderCache" (
    del /s /f /q "%LOCALAPPDATA%\Intel\ShaderCache\*.*" >nul 2>&1
    for /d %%p in ("%LOCALAPPDATA%\Intel\ShaderCache\*") do rd /s /q "%%p" >nul 2>&1
    echo %green%  [+] Purged: %LOCALAPPDATA%\Intel\ShaderCache%u%
)

echo.
echo %c%[4/5] Purging DirectX System Shader Cache [D3DSCache]...%u%
if exist "%LOCALAPPDATA%\D3DSCache" (
    del /s /f /q "%LOCALAPPDATA%\D3DSCache\*.*" >nul 2>&1
    for /d %%p in ("%LOCALAPPDATA%\D3DSCache\*") do rd /s /q "%%p" >nul 2>&1
    echo %green%  [+] Purged: %LOCALAPPDATA%\D3DSCache%u%
)

echo.
echo %c%[5/5] Purging Steam Shader Pre-Caching...%u%
for %%D in (
    "%ProgramFiles(x86)%\Steam\steamapps\shadercache"
    "%ProgramFiles%\Steam\steamapps\shadercache"
) do (
    if exist "%%~D" (
        del /s /f /q "%%~D\*.*" >nul 2>&1
        for /d %%p in ("%%~D\*") do rd /s /q "%%p" >nul 2>&1
        echo %green%  [+] Purged: %%~D%u%
    )
)
goto :eof

:OBSOptimizer
cls
call :SetupConsole
echo.
echo.
echo %c%╔══════════════════════════════════════════════════════════════════════════════╗
echo ║                            OBS OPTIMIZER                                     ║
echo ╚══════════════════════════════════════════════════════════════════════════════╝%u%
echo.
echo %c%This will optimize OBS Studio encoding settings for your GPU:%u%
echo %c%• Select encoder: NVENC (NVIDIA) / AMF (AMD) / x264 (CPU)%u%
echo %c%• Three quality tiers: Performance / Balanced / Quality%u%
echo %c%• Updates all existing OBS profiles automatically%u%
echo %c%• Sets OBS process priority to Above Normal via registry%u%
echo.
set "OBSProfilePath=%APPDATA%\obs-studio\basic\profiles"
if not exist "%OBSProfilePath%" (
    echo %red%[!] OBS Studio profiles not found at:%u%
    echo %c%    %OBSProfilePath%%u%
    echo %c%    Launch OBS at least once to create profiles, then re-run.%u%
    echo.
    echo %c%══════════════════════════ PRESS ANY KEY TO CONTINUE ══════════════════════════%u%
    pause >nul
    goto AdvancedMenu
)
echo %c%[✓] OBS profiles found%u%
echo.
echo %c%Select encoder:%u%
echo %c%[1] NVIDIA NVENC    - Hardware encoding (NVIDIA GPU required)%u%
echo %c%[2] AMD AMF / VCE   - Hardware encoding (AMD GPU required)%u%
echo %c%[3] x264 CPU        - Software encoding (any CPU)%u%
echo.
choice /C 123 /N /M "%c%Choose encoder [1/2/3] »%u% "
set "ENC_PICK=%errorlevel%"
echo.
echo %c%Select quality tier:%u%
echo %c%[1] Performance  - Low overhead, best for competitive gaming%u%
echo %c%[2] Balanced     - Good quality with moderate impact%u%
echo %c%[3] Quality      - High quality for recording / content creation%u%
echo.
choice /C 123 /N /M "%c%Choose tier [1/2/3] »%u% "
set "QUAL_PICK=%errorlevel%"

if "%ENC_PICK%"=="1" set "ENC_NAME=jim_nvenc"
if "%ENC_PICK%"=="2" set "ENC_NAME=amd_amf_h264"
if "%ENC_PICK%"=="3" set "ENC_NAME=obs_x264"
if not defined ENC_NAME set "ENC_NAME=jim_nvenc"

if "%QUAL_PICK%"=="1" (
    set "OBS_PRESET=performance"
    set "OBS_BITRATE=4000"
    set "OBS_RECQUALITY=Small"
)
if "%QUAL_PICK%"=="2" (
    set "OBS_PRESET=quality"
    set "OBS_BITRATE=6000"
    set "OBS_RECQUALITY=Stream"
)
if "%QUAL_PICK%"=="3" (
    set "OBS_PRESET=slow"
    set "OBS_BITRATE=8000"
    set "OBS_RECQUALITY=Lossless"
)
if not defined OBS_PRESET (
    set "OBS_PRESET=quality"
    set "OBS_BITRATE=6000"
    set "OBS_RECQUALITY=Stream"
)

echo.
echo %c%[1/2] Updating OBS profile settings...%u%
chcp 437 >nul
powershell -NoProfile -Command "$p='%OBSProfilePath%'; $e='%ENC_NAME%'; $q='%OBS_RECQUALITY%'; $b='%OBS_BITRATE%'; Get-ChildItem $p -Directory -EA SilentlyContinue | ForEach-Object { $f = Join-Path $_.FullName 'basic.ini'; if (Test-Path $f) { $c = Get-Content $f -Raw; if ($c -match 'StreamEncoder') { $c = $c -replace '(?m)^StreamEncoder=.*', \"StreamEncoder=$e\" } else { $c += \"`r`nStreamEncoder=$e\" }; if ($c -match 'RecEncoder') { $c = $c -replace '(?m)^RecEncoder=.*', \"RecEncoder=$e\" } else { $c += \"`r`nRecEncoder=$e\" }; if ($c -match 'RecQuality') { $c = $c -replace '(?m)^RecQuality=.*', \"RecQuality=$q\" } else { $c += \"`r`nRecQuality=$q\" }; if ($c -match 'VBitrate') { $c = $c -replace '(?m)^VBitrate=.*', \"VBitrate=$b\" } else { $c += \"`r`nVBitrate=$b\" }; Set-Content $f $c -NoNewline } }" >nul 2>&1
chcp 65001 >nul





















echo ╚══════════════════════════════════════════════════════════════════════════════╝%u%
echo.
echo %c%MSI (Message Signaled Interrupts) allows hardware devices to process interrupts%u%
echo %c%without sharing legacy line-based IRQs, significantly lowering DPC latency:%u%
echo.
echo %c%• GPU / Video Controllers    : High priority MSI (Safest ^& highest gaming gain)%u%
echo %c%• NVMe Storage Controllers    : Native MSI-X optimization%u%
echo %c%• Network Adapters (Ethernet) : Low-latency packet processing%u%
echo %c%• USB 3.x Host Controllers   : Low input latency for gaming mice ^& keyboards%u%
echo %c%• Legacy IDE/SATA Controllers: Excluded for stability (prevents BSOD / hangs)%u%
echo.
echo                            %c%╔═══════════════════════════════════════════════════╗
echo                            ║  [1] Safe MSI Mode (GPU + NVMe + Net + USB)       ║
echo                            ║  [2] Apply GPU-Only MSI Mode (Maximum Safety)     ║
echo                            ║  [3] Restore Default IRQ / Line Interrupts        ║
echo                            ║                                                   ║
echo                            ║  [0] Return to Previous Menu                      ║
echo                            ╚═══════════════════════════════════════════════════╝%u%
echo.
choice /C 0123 /N /M "%c%Select option »%u% "
if errorlevel 4 goto RestoreMSIDefaults
if errorlevel 3 goto ApplyGPUOnlyMSI
if errorlevel 2 goto ApplySafeMSIMode
if errorlevel 1 (if defined MSI_RETURN (goto %MSI_RETURN%) else (goto AdvancedMenu))

:ApplySafeMSIMode
echo.
echo %c%[1/4] Configuring GPU / Video Controller MSI...%u%
chcp 437 >nul
for /f "delims=" %%i in ('powershell -NoProfile -Command "(Get-CimInstance Win32_VideoController).PNPDeviceID | Where-Object { $_ -match 'PCI\\VEN_(10DE|1002)' }" 2^>nul') do (
	reg.exe add "HKLM\SYSTEM\CurrentControlSet\Enum\%%i\Device Parameters\Interrupt Management\MessageSignaledInterruptProperties" /v "MSISupported" /t REG_DWORD /d "1" /f >nul 2>&1
	reg.exe add "HKLM\SYSTEM\CurrentControlSet\Enum\%%i\Device Parameters\Interrupt Management\Affinity Policy" /v "DevicePriority" /t REG_DWORD /d "2" /f >nul 2>&1
)
for /f "delims=" %%i in ('powershell -NoProfile -Command "(Get-CimInstance Win32_VideoController).PNPDeviceID | Where-Object { $_ -match 'PCI\\VEN_8086' }" 2^>nul') do (
	reg.exe add "HKLM\SYSTEM\CurrentControlSet\Enum\%%i\Device Parameters\Interrupt Management\MessageSignaledInterruptProperties" /v "MSISupported" /t REG_DWORD /d "1" /f >nul 2>&1
	reg.exe delete "HKLM\SYSTEM\CurrentControlSet\Enum\%%i\Device Parameters\Interrupt Management\Affinity Policy" /v "DevicePriority" /f >nul 2>&1
)
chcp 65001 >nul
echo %c%  ✓ Dedicated GPU MSI mode configured (High Priority), iGPU safe defaults preserved%u%

echo.
echo %c%[2/4] Configuring NVMe Storage Controller MSI...%u%
chcp 437 >nul
powershell.exe -NoProfile -Command "Get-PnpDevice | Where-Object {$_.FriendlyName -like '*NVMe*' -and $_.InstanceId -like 'PCI*'} | ForEach-Object {try{New-ItemProperty -Path \"HKLM:\SYSTEM\CurrentControlSet\Enum\$($_.InstanceId)\Device Parameters\Interrupt Management\MessageSignaledInterruptProperties\" -Name 'MSISupported' -Value 1 -PropertyType DWord -Force -ErrorAction SilentlyContinue}catch{}}" >nul 2>&1
for /f "delims=" %%j in ('powershell -NoProfile -Command "(Get-CimInstance Win32_SCSIController -ErrorAction SilentlyContinue).PNPDeviceID | Where-Object { $_ -like 'PCI\VEN_*' }" 2^>nul') do (
    reg add "HKLM\SYSTEM\CurrentControlSet\Enum\%%j\Device Parameters\Interrupt Management\MessageSignaledInterruptProperties" /v "MSISupported" /t REG_DWORD /d "1" /f >nul 2>&1
)
chcp 65001 >nul
echo %c%  ✓ NVMe storage controllers configured for MSI%u%

echo.
echo %c%[3/4] Configuring Network Adapter MSI...%u%
chcp 437 >nul
for /f "delims=" %%i in ('powershell -NoProfile -Command "(Get-CimInstance Win32_NetworkAdapter | Where-Object { $_.Name -notmatch 'Wi-Fi|Wireless|802\.11' }).PNPDeviceID | Where-Object { $_ -like 'PCI\VEN_*' }" 2^>nul') do (
	reg.exe add "HKLM\SYSTEM\CurrentControlSet\Enum\%%i\Device Parameters\Interrupt Management\MessageSignaledInterruptProperties" /v "MSISupported" /t REG_DWORD /d "1" /f >nul 2>&1
	reg.exe add "HKLM\SYSTEM\CurrentControlSet\Enum\%%i\Device Parameters\Interrupt Management\Affinity Policy" /v "DevicePriority" /t REG_DWORD /d "2" /f >nul 2>&1
)
chcp 65001 >nul
echo %c%  ✓ Ethernet network adapters configured for MSI (Wi-Fi sleep/wake safe)%u%

echo.
echo %c%[4/4] Configuring USB 3.x Host Controller MSI...%u%
chcp 437 >nul
for /f "delims=" %%i in ('powershell -NoProfile -Command "(Get-CimInstance Win32_USBController -ErrorAction SilentlyContinue).PNPDeviceID | Where-Object { $_ -like 'PCI\VEN_*' }" 2^>nul') do (
	reg.exe add "HKLM\SYSTEM\CurrentControlSet\Enum\%%i\Device Parameters\Interrupt Management\MessageSignaledInterruptProperties" /v "MSISupported" /t REG_DWORD /d "1" /f >nul 2>&1
)
chcp 65001 >nul
echo %c%  ✓ USB host controllers configured for MSI%u%

echo.
echo %c%═══════════════════════════════════════════════════════════════════════════════%u%
echo %green%  [SUCCESS] Safe MSI configuration applied!%u%
echo %c%  Note: A system reboot is recommended for interrupt changes to take effect.%u%
echo %c%═══════════════════════════════════════════════════════════════════════════════%u%
echo.
pause

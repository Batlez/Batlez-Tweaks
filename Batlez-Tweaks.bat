:Step1_DetectGPU
echo %white%[1/12]%u% %c%Detecting NVIDIA Graphics Hardware...%u%
set "NVIDIA_FOUND=false"
for /f "tokens=*" %%a in ('reg query "HKLM\SYSTEM\CurrentControlSet\Control\Class\{4d36e968-e325-11ce-bfc1-08002be10318}" 2^>nul ^| findstr /r "\\00[0-9][0-9]$"') do (
    reg query "%%a" /v DriverDesc 2>nul | findstr /i "NVIDIA" >nul && set "NVIDIA_FOUND=true"
)
if "%NVIDIA_FOUND%"=="true" (
    echo %green%  ✓ NVIDIA GPU detected%u%
) else (
    echo %orange%  • No active NVIDIA GPU found%u%
    echo %c%  • Optimization will apply for future compatibility%u%
)
echo.
exit /b

:Step2_DiscoverServices
echo %white%[2/12]%u% %c%Discovering NVIDIA Services...%u%

set "TELEMETRY_SERVICES="
set "NVIDIA_APP_SERVICES="
set "ESSENTIAL_SERVICES="
set "servicesFound=false"

echo %c%  • Checking for known NVIDIA services...%u%
for %%S in (
    NVDisplay.ContainerLocalSystem
    NVDisplay.Container
    nvdisplay.container
    NvContainerLocalSystem
    nvcontainer
    NvTelemetryContainer
    NvTmMon
    NvTmRep
    GfExperienceService
    NVIDIAAppService
    NVIDIA.GeForceExperience.Service
    FvSvc
    NvStreamSvc
    NVSvc
) do (
    sc query "%%S" >nul 2>&1 && (
        set "servicesFound=true"
        
        if /i "%%S"=="NVDisplay.ContainerLocalSystem" set "ESSENTIAL_SERVICES=!ESSENTIAL_SERVICES! %%S" & echo %c%    • Found: %%S ^(Essential Driver Service^)%u%
        if /i "%%S"=="NVDisplay.Container" set "ESSENTIAL_SERVICES=!ESSENTIAL_SERVICES! %%S" & echo %c%    • Found: %%S ^(Essential Driver Service^)%u%
        if /i "%%S"=="nvdisplay.container" set "ESSENTIAL_SERVICES=!ESSENTIAL_SERVICES! %%S" & echo %c%    • Found: %%S ^(Essential Driver Service^)%u%
        if /i "%%S"=="NVSvc" set "ESSENTIAL_SERVICES=!ESSENTIAL_SERVICES! %%S" & echo %c%    • Found: %%S ^(Essential Driver Service^)%u%
        
        if /i "%%S"=="NvContainerLocalSystem" set "NVIDIA_APP_SERVICES=!NVIDIA_APP_SERVICES! %%S" & echo %c%    • Found: %%S ^(NVIDIA App Service^)%u%
        if /i "%%S"=="nvcontainer" set "NVIDIA_APP_SERVICES=!NVIDIA_APP_SERVICES! %%S" & echo %c%    • Found: %%S ^(NVIDIA App Service^)%u%
        if /i "%%S"=="GfExperienceService" set "NVIDIA_APP_SERVICES=!NVIDIA_APP_SERVICES! %%S" & echo %c%    • Found: %%S ^(NVIDIA App Service^)%u%
        if /i "%%S"=="NVIDIAAppService" set "NVIDIA_APP_SERVICES=!NVIDIA_APP_SERVICES! %%S" & echo %c%    • Found: %%S ^(NVIDIA App Service^)%u%
        if /i "%%S"=="NVIDIA.GeForceExperience.Service" set "NVIDIA_APP_SERVICES=!NVIDIA_APP_SERVICES! %%S" & echo %c%    • Found: %%S ^(NVIDIA App Service^)%u%
        if /i "%%S"=="FvSvc" set "NVIDIA_APP_SERVICES=!NVIDIA_APP_SERVICES! %%S" & echo %c%    • Found: %%S ^(NVIDIA FrameView Service^)%u%
        if /i "%%S"=="NvStreamSvc" set "NVIDIA_APP_SERVICES=!NVIDIA_APP_SERVICES! %%S" & echo %c%    • Found: %%S ^(NVIDIA Streamer Service^)%u%
        
        if /i "%%S"=="NvTelemetryContainer" set "TELEMETRY_SERVICES=!TELEMETRY_SERVICES! %%S" & echo %c%    • Found: %%S ^(Telemetry^)%u%
        if /i "%%S"=="NvTmMon" set "TELEMETRY_SERVICES=!TELEMETRY_SERVICES! %%S" & echo %c%    • Found: %%S ^(Telemetry^)%u%
        if /i "%%S"=="NvTmRep" set "TELEMETRY_SERVICES=!TELEMETRY_SERVICES! %%S" & echo %c%    • Found: %%S ^(Telemetry^)%u%
    )
)

echo %c%  • Scanning all services for NVIDIA references...%u%
for /f "skip=1 tokens=2" %%S in ('sc query type= service state= all 2^>nul ^| findstr "SERVICE_NAME"') do (
    echo %%S | findstr /i "nvidia nvcontainer nvdisplay geforce" >nul 2>&1 && (
        set "_isKnown=false"
        for %%K in (!ESSENTIAL_SERVICES! !NVIDIA_APP_SERVICES! !TELEMETRY_SERVICES!) do (
            if /i "%%S"=="%%K" set "_isKnown=true"
        )
        if "!_isKnown!"=="false" (
            set "servicesFound=true"
            echo %%S | findstr /i "telemetry" >nul 2>&1 && (
                set "TELEMETRY_SERVICES=!TELEMETRY_SERVICES! %%S"
                echo %c%    • Found additional service: %%S ^(Telemetry^)%u%
            ) || echo %%S | findstr /i "display" >nul 2>&1 && (
                set "ESSENTIAL_SERVICES=!ESSENTIAL_SERVICES! %%S"
                echo %c%    • Found additional service: %%S ^(Essential Driver Service^)%u%
            ) || (
                set "NVIDIA_APP_SERVICES=!NVIDIA_APP_SERVICES! %%S"
                echo %c%    • Found additional service: %%S ^(NVIDIA App Service^)%u%
            )
        )
    )
)

tasklist /svc 2>nul | findstr /i "nvcontainer nvdisplay nvidia" >nul 2>&1 && (
    echo %c%  • NVIDIA background processes are currently active%u%
)

if "%servicesFound%"=="false" (
    echo %c%  • No NVIDIA services found ^(clean driver installation^)%u%
) else (
    echo %green%  ✓ Service discovery completed%u%
)

if defined ESSENTIAL_SERVICES (echo %c%  • Essential Services: %ESSENTIAL_SERVICES%%u%) else (echo %c%  • Essential Services: None%u%)
if defined NVIDIA_APP_SERVICES (echo %c%  • App Services:       %NVIDIA_APP_SERVICES%%u%) else (echo %c%  • App Services:       None%u%)
if defined TELEMETRY_SERVICES (echo %c%  • Telemetry Services:  %TELEMETRY_SERVICES%%u%) else (echo %c%  • Telemetry Services:  None%u%)
echo.
exit /b

:Step3_StopServices
echo %white%[3/12]%u% %c%Stopping NVIDIA Services...%u%

set "servicesStopped=false"

if defined TELEMETRY_SERVICES (
    for %%S in (%TELEMETRY_SERVICES%) do (
        sc query "%%S" 2>nul | findstr /i "RUNNING" >nul 2>&1 && (
            net stop "%%S" >nul 2>&1
            if !errorlevel! equ 0 (
                echo %green%  ✓ Stopped telemetry service: %%S%u%
                set "servicesStopped=true"
            ) else (
                echo %orange%  ! Failed to stop: %%S ^(Requires Administrator^)%u%
            )
        )
    )
)

if "%DISABLE_NVIDIA_APP%"=="true" (
    if defined NVIDIA_APP_SERVICES (
        for %%S in (%NVIDIA_APP_SERVICES%) do (
            sc query "%%S" 2>nul | findstr /i "RUNNING" >nul 2>&1 && (
                net stop "%%S" >nul 2>&1
                if !errorlevel! equ 0 (
                    echo %green%  ✓ Stopped app service: %%S%u%
                    set "servicesStopped=true"
                ) else (
                    echo %orange%  ! Failed to stop: %%S ^(Requires Administrator^)%u%
                )
            )
        )
    )
) else (
    echo %c%  • NVIDIA App services kept running%u%
)

if "%servicesStopped%"=="false" echo %c%  • No running services required stopping%u%
echo.
exit /b

:Step4_DisableTelemetry
echo %white%[4/12]%u% %c%Disabling NVIDIA Telemetry Services...%u%

set "servicesDisabled=false"

if defined TELEMETRY_SERVICES (
    for %%S in (%TELEMETRY_SERVICES%) do (
        sc query "%%S" >nul 2>&1 && (
            sc qc "%%S" 2>nul | findstr /i "START_TYPE.*DISABLED" >nul 2>&1 || (
                sc config "%%S" start= disabled >nul 2>&1
                if !errorlevel! equ 0 (
                    echo %green%  ✓ Disabled telemetry service: %%S%u%
                    set "servicesDisabled=true"
                ) else (
                    echo %orange%  ! Failed to disable: %%S ^(Requires Administrator^)%u%
                )
            )
        )
    )
)

if "%DISABLE_NVIDIA_APP%"=="true" (
    if defined NVIDIA_APP_SERVICES (
        for %%S in (%NVIDIA_APP_SERVICES%) do (
            sc query "%%S" >nul 2>&1 && (
                sc qc "%%S" 2>nul | findstr /i "START_TYPE.*DISABLED" >nul 2>&1 || (
                    sc config "%%S" start= disabled >nul 2>&1
                    if !errorlevel! equ 0 (
                        echo %green%  ✓ Disabled app service: %%S%u%
                        set "servicesDisabled=true"
                    ) else (
                        echo %orange%  ! Failed to disable: %%S ^(Requires Administrator^)%u%
                    )
                )
            )
        )
    )
) else (
    echo %c%  • NVIDIA App services kept enabled%u%
)

if "%servicesDisabled%"=="false" echo %c%  • No services required disabling%u%
echo.
exit /b

:Step5_ManageStartup
echo %white%[5/12]%u% %c%Managing Startup Programs...%u%

if "%DISABLE_NVIDIA_APP%"=="true" (
    set "startupRemoved=false"
    for %%R in (
        "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
        "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
    ) do (
        for %%V in (
            "NVIDIA GeForce Experience"
            "NvBackend"
            "NVIDIA App"
        ) do (
            reg query "%%R" /v "%%~V" >nul 2>&1 && (
                reg delete "%%R" /v "%%~V" /f >nul 2>&1
                if !errorlevel! equ 0 (
                    echo %green%  ✓ Removed from startup: %%~V%u%
                    set "startupRemoved=true"
                ) else (
                    echo %orange%  ! Failed to remove: %%~V%u%
                )
            )
        )
    )
    
    tasklist | findstr /i "NVIDIA App.exe" >nul 2>&1 && (
        taskkill /f /im "NVIDIA App.exe" >nul 2>&1
        if !errorlevel! equ 0 (
            echo %green%  ✓ Terminated NVIDIA App process%u%
            set "startupRemoved=true"
        )
    )
    
    if exist "C:\Program Files\NVIDIA Corporation\NVIDIA App\CEF\NVIDIA App.exe" (
        echo %c%  • NVIDIA App executable found%u%
        choice /C YN /M "%c%  Rename NVIDIA App.exe to prevent auto-start? (Y/N)%u%"
        if !errorlevel! equ 1 (
            ren "C:\Program Files\NVIDIA Corporation\NVIDIA App\CEF\NVIDIA App.exe" "NVIDIA App.exe.disabled" >nul 2>&1
            if !errorlevel! equ 0 (
                echo %green%  ✓ NVIDIA App executable disabled%u%
                set "startupRemoved=true"
            ) else (
                echo %orange%  ! Failed to disable NVIDIA App executable%u%
            )
        )
    )
    
    if "%startupRemoved%"=="false" echo %c%  • No startup entries found to remove%u%
) else (
    echo %c%  • NVIDIA App kept in startup%u%
    
    if exist "C:\Program Files\NVIDIA Corporation\NVIDIA App\CEF\NVIDIA App.exe.disabled" (
        ren "C:\Program Files\NVIDIA Corporation\NVIDIA App\CEF\NVIDIA App.exe.disabled" "NVIDIA App.exe" >nul 2>&1
        if !errorlevel! equ 0 echo %green%  ✓ NVIDIA App executable restored%u%
    )
)
echo.
exit /b

:Step6_ManageTasks
echo %white%[6/12]%u% %c%Managing Scheduled Tasks...%u%

set "telemetryTasksModified=false"
for %%T in (
    "NvTmRep_CrashReport1_{B2FE1952-0186-46C3-BAEC-A80AA35AC5B8}"
    "NvTmRep_CrashReport2_{B2FE1952-0186-46C3-BAEC-A80AA35AC5B8}"
    "NvTmRep_CrashReport3_{B2FE1952-0186-46C3-BAEC-A80AA35AC5B8}"
    "NvTmRep_CrashReport4_{B2FE1952-0186-46C3-BAEC-A80AA35AC5B8}"
) do (
    schtasks /query /tn "%%~T" >nul 2>&1 && (
        schtasks /query /tn "%%~T" /fo csv | findstr /i "Disabled" >nul || (
            schtasks /change /disable /tn "%%~T" >nul 2>&1
            if !errorlevel! equ 0 (
                echo %green%  ✓ Disabled telemetry task: %%~T%u%
                set "telemetryTasksModified=true"
            ) else (
                echo %orange%  ! Failed to disable task: %%~T%u%
            )

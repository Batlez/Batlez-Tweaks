:loading
cls
call :SetupConsole
if not defined c set "c=%cyan%"
echo.
echo %c%                    ╔══════════════════════════════════════════════════════════════════════════════╗
echo                     ║                                %violet%BATLEZ TWEAKS%u%%c%                                 ║
echo                     ║                 %lime%Developed by%u% %violet%Batlez%u%%c%  •  %lime%Discord:%u% %violet%Batlez%u%%c%                      ║
echo                     ╚══════════════════════════════════════════════════════════════════════════════╝%u%
echo.
echo %c%                    ┌───────────────────────────────── %yellow%DISCLAIMER%u%%c% ─────────────────────────────────┐
echo                     │                                                                              │
echo                     │     %lime%I%u% %underline%%red%cannot%u%%lime% guarantee an FPS increase. Use these tweaks at your own risk.%u%%c%   │
echo                     │        %lime%This utility is designed for a Clean and Stock Windows install.%u%%c%       │
echo                     │                                                                              │

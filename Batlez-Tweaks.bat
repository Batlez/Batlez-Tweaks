:RestoreSnippingTool
cls
call :SetupConsole
echo.
echo.
echo %c%╔═══════════════════════════════════════════════════════════════════════════════╗
echo ║                     RESTORE / ENABLE SNIPPING TOOL                            ║
echo ╚═══════════════════════════════════════════════════════════════════════════════╝%u%
echo.
echo %c%This tool restores and re-enables Windows Snipping Tool (Screen Snip):%u%
echo %c%• Re-enables ClipSVC and LicenseManager (required for UWP apps to launch)%u%
echo %c%• Removes DisableSnippingTool registry policy restrictions%u%
echo %c%• Re-enables PrintScreen key shortcut for screen snipping%u%
echo %c%• Re-registers Microsoft.ScreenSketch UWP package for all users%u%
echo %c%• Re-registers ms-screenclip protocol handler%u%
echo %c%• Restarts Windows Explorer to apply hotkey changes immediately%u%
echo.
choice /C YN /M "%c%Restore and enable Snipping Tool? (Y/N)%u%"
if errorlevel 2 goto WindowsMenu

echo.
echo %c%[1/6] Re-enabling core licensing services (ClipSVC and LicenseManager)...%u%
sc config "ClipSVC" start= demand >nul 2>&1
sc start "ClipSVC" >nul 2>&1
reg add "HKLM\System\CurrentControlSet\Services\ClipSVC" /v "Start" /t REG_DWORD /d "3" /f >nul 2>&1
sc config "LicenseManager" start= demand >nul 2>&1
sc start "LicenseManager" >nul 2>&1
reg add "HKLM\System\CurrentControlSet\Services\LicenseManager" /v "Start" /t REG_DWORD /d "3" /f >nul 2>&1
sc config "AppXSvc" start= auto >nul 2>&1
echo %green%  [+] Licensing services active%u%

echo.
echo %c%[2/6] Removing Snipping Tool policy blocks...%u%
reg delete "HKCU\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer" /v "DisableSnippingTool" /f >nul 2>&1
reg delete "HKLM\SOFTWARE\Policies\Microsoft\Windows\TabletPC" /v "DisableSnippingTool" /f >nul 2>&1
reg delete "HKLM\SOFTWARE\Policies\Microsoft\Windows\Appx" /v "BlockNonAdminUserInstall" /f >nul 2>&1
echo %green%  [+] Done%u%

echo.
echo %c%[3/6] Enabling PrintScreen key shortcut for screen snipping...%u%
reg add "HKCU\Control Panel\Keyboard" /v "PrintScreenKeyForSnippingEnabled" /t REG_DWORD /d "1" /f >nul 2>&1
echo %green%  [+] Done%u%

echo.
echo %c%[4/6] Re-registering Snipping Tool (ScreenSketch) package...%u%
chcp 437 >nul
powershell -NoProfile -ExecutionPolicy Bypass -Command "$pkg = Get-AppxPackage -AllUsers *Microsoft.ScreenSketch* -ErrorAction SilentlyContinue; if ($pkg) { Add-AppxPackage -DisableDevelopmentMode -Register \"$($pkg.InstallLocation)\AppXManifest.xml\" -ErrorAction SilentlyContinue; Write-Host '  + Registered: ' $pkg.PackageFullName -ForegroundColor Green } else { $manifest = Get-ChildItem 'C:\Program Files\WindowsApps\Microsoft.ScreenSketch*' -Filter 'AppXManifest.xml' -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1; if ($manifest) { Add-AppxPackage -DisableDevelopmentMode -Register $manifest.FullName -ErrorAction SilentlyContinue; Write-Host '  + Registered from WindowsApps' -ForegroundColor Green } else { Write-Host '  ! Snipping Tool package not found locally - can be installed from Store/winget' -ForegroundColor Yellow } }"
chcp 65001 >nul
echo %green%  [+] Done%u%

echo.
echo %c%[4/5] Ensuring ms-screenclip protocol handler is active...%u%
reg add "HKCR\ms-screenclip" /v "URL Protocol" /t REG_SZ /d "" /f >nul 2>&1
reg add "HKCU\Software\Classes\ms-screenclip" /v "URL Protocol" /t REG_SZ /d "" /f >nul 2>&1
echo %green%  [+] Done%u%

echo.
echo %c%[5/5] Restarting Windows Explorer...%u%
taskkill /f /im explorer.exe >nul 2>&1
timeout /t 1 >nul /nobreak
start explorer.exe >nul 2>&1
echo %green%  [+] Explorer restarted%u%

echo.
echo %c%═══════════════════════════════════════════════════════════════════════════════%u%
echo %green%✓ Snipping Tool (Win+Shift+S / PrintScreen) restored successfully!%u%
echo %c%═══════════════════════════════════════════════════════════════════════════════%u%
echo.
echo %c%══════════════════════════ PRESS ANY KEY TO CONTINUE ══════════════════════════%u%
pause >nul
goto WindowsMenu

:ToggleNotifications
cls

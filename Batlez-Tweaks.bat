:Affinity
cls
call :SetupConsole
echo.
echo.
echo %c%╔══════════════════════════════════════════════════════════════════════════════╗
echo ║             CPU CORE ^& HARDWARE INTERRUPT AFFINITY OPTIMIZER                  ║
echo ╚══════════════════════════════════════════════════════════════════════════════╝%u%
echo.
echo %c%Steering hardware interrupts (GPU, Network, USB) to dedicated CPU cores%u%
echo %c%prevents interrupt storms on Core 0, eliminating micro-stutters and input lag.%u%
echo.
chcp 437 >nul
for /f %%f in ('powershell -NoProfile -Command "(Get-CimInstance Win32_Processor).NumberOfCores" 2^>nul') do set "NumberOfCores=%%f"
for /f %%f in ('powershell -NoProfile -Command "(Get-CimInstance Win32_Processor).NumberOfLogicalProcessors" 2^>nul') do set "NumberOfLogicalProcessors=%%f"
chcp 65001 >nul
if not defined NumberOfCores set "NumberOfCores=4"
if not defined NumberOfLogicalProcessors set "NumberOfLogicalProcessors=8"
set "SMT_STATUS=Disabled"
if !NumberOfLogicalProcessors! gtr !NumberOfCores! set "SMT_STATUS=Active (SMT/HT)"
echo %c%• Detected CPU Cores    : %u%%NumberOfCores% Physical Cores
echo %c%• Logical Processors    : %u%%NumberOfLogicalProcessors% Threads [%SMT_STATUS%]
echo %c%• Target Devices        : %u%Dedicated GPU, Ethernet Adapter, USB 3.x Host
echo.
echo                            %c%╔═══════════════════════════════════════════════════╗
echo                            ║  [1] Optimize Hardware Interrupt Affinity (Cores) ║
echo                            ║  [2] Mask Background Apps off Primary Game Cores  ║
echo                            ║  [3] Restore Default Windows Affinity Policy      ║
echo                            ║                                                   ║
echo                            ║  [0] Return to Previous Menu                      ║
echo                            ╚═══════════════════════════════════════════════════╝%u%
echo.
choice /C 0123 /N /M "%c%Select option »%u% "
if errorlevel 4 goto RestoreAffinityDefaults
if errorlevel 3 goto ApplyBackgroundAffinityMask
if errorlevel 2 goto ApplyHardwareInterruptAffinity
if errorlevel 1 (if defined AFFINITY_RETURN (goto %AFFINITY_RETURN%) else (goto AdvancedMenu))

:ApplyHardwareInterruptAffinity
echo.
echo %c%[1/3] Configuring GPU Interrupt Affinity...%u%
chcp 437 >nul
for /f "delims=" %%i in ('powershell -NoProfile -Command "(Get-CimInstance Win32_VideoController).PNPDeviceID | Where-Object { $_ -match 'PCI\\VEN_(10DE|1002)' }" 2^>nul') do (
    reg.exe add "HKLM\SYSTEM\CurrentControlSet\Enum\%%i\Device Parameters\Interrupt Management\Affinity Policy" /v "DevicePolicy" /t REG_DWORD /d "3" /f >nul 2>&1
    reg.exe delete "HKLM\SYSTEM\CurrentControlSet\Enum\%%i\Device Parameters\Interrupt Management\Affinity Policy" /v "AssignmentSetOverride" /f >nul 2>&1
)
chcp 65001 >nul
echo %c%✓ GPU routed to all close physical cores (DevicePolicy=3)%u%

echo.
echo %c%[2/3] Configuring Network Interrupt Affinity...%u%
chcp 437 >nul
for /f "delims=" %%i in ('powershell -NoProfile -Command "(Get-CimInstance Win32_NetworkAdapter).PNPDeviceID | Where-Object { $_ -like 'PCI\\VEN_*' }" 2^>nul') do (
    if !NumberOfCores! gtr 4 (
        reg.exe add "HKLM\SYSTEM\CurrentControlSet\Enum\%%i\Device Parameters\Interrupt Management\Affinity Policy" /v "DevicePolicy" /t REG_DWORD /d "5" /f >nul 2>&1
        reg.exe delete "HKLM\SYSTEM\CurrentControlSet\Enum\%%i\Device Parameters\Interrupt Management\Affinity Policy" /v "AssignmentSetOverride" /f >nul 2>&1
    ) else (
        reg.exe add "HKLM\SYSTEM\CurrentControlSet\Enum\%%i\Device Parameters\Interrupt Management\Affinity Policy" /v "DevicePolicy" /t REG_DWORD /d "3" /f >nul 2>&1
        reg.exe delete "HKLM\SYSTEM\CurrentControlSet\Enum\%%i\Device Parameters\Interrupt Management\Affinity Policy" /v "AssignmentSetOverride" /f >nul 2>&1
    )
)
chcp 65001 >nul
echo %c%✓ Network adapter interrupts routed for low-jitter packet handling%u%

echo.
echo %c%[3/3] Configuring USB Controller Interrupt Affinity...%u%
chcp 437 >nul
for /f "delims=" %%i in ('powershell -NoProfile -Command "(Get-CimInstance Win32_USBController -ErrorAction SilentlyContinue).PNPDeviceID | Where-Object { $_ -like 'PCI\\VEN_*' }" 2^>nul') do (
    reg.exe add "HKLM\SYSTEM\CurrentControlSet\Enum\%%i\Device Parameters\Interrupt Management\Affinity Policy" /v "DevicePolicy" /t REG_DWORD /d "3" /f >nul 2>&1
    reg.exe delete "HKLM\SYSTEM\CurrentControlSet\Enum\%%i\Device Parameters\Interrupt Management\Affinity Policy" /v "AssignmentSetOverride" /f >nul 2>&1
)
chcp 65001 >nul
echo %c%✓ USB host controllers optimized for polling rate stability%u%

echo.
echo %c%═══════════════════════════════════════════════════════════════════════════════%u%
echo %green%  [SUCCESS] Hardware Interrupt Affinity optimized!%u%
echo %c%  Note: A system reboot is recommended for interrupt changes to take effect.%u%
echo %c%═══════════════════════════════════════════════════════════════════════════════%u%
echo.
pause
if defined AFFINITY_RETURN (goto %AFFINITY_RETURN%) else (goto AdvancedMenu)

:ApplyBackgroundAffinityMask
echo.
echo %c%Masking background apps off Core 0 and primary gaming threads...%u%
chcp 437 >nul
powershell -NoProfile -Command "$cores = (Get-CimInstance Win32_Processor).NumberOfLogicalProcessors; if ($cores -ge 6) { $mask = [int64]0; for ($i=2; $i -lt $cores; $i++) { $mask = $mask -bor ([int64]1 -shl $i) }; $procs = @('Discord','Spotify','Steam','chrome','msedge','brave','firefox','obs64'); foreach ($name in $procs) { Get-Process $name -EA SilentlyContinue | ForEach-Object { try { $_.ProcessorAffinity = [IntPtr]$mask } catch {} } } }" >nul 2>&1
chcp 65001 >nul
echo %c%✓ Background applications masked away from Core 0 and Core 1%u%
echo %c%✓ Primary CPU cores reserved for high-priority gaming frames%u%

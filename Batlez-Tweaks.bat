    if not defined _t (
        for /F "tokens=2* skip=2" %%a in ('reg query "%_k%\000%%i" /v ProviderName 2^>nul') do (
            echo %%b|findstr /i "NVIDIA" >nul && (set "_t=000%%i")
        )
        if not defined _t (
            for /F "tokens=2* skip=2" %%a in ('reg query "%_k%\000%%i" /v DriverDesc 2^>nul') do (
                echo %%b|findstr /i "NVIDIA" >nul && (set "_t=000%%i")
            )
        )
    )
)

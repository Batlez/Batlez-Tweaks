:RestoreCalendarAndBrightness
cls
call :SetupConsole
echo.
echo.
echo %c%╔═══════════════════════════════════════════════════════════════════════════════╗
echo ║               RESTORE TASKBAR CALENDAR ^& BRIGHTNESS SLIDER                   ║
echo ╚═══════════════════════════════════════════════════════════════════════════════╝%u%
echo.
echo %c%This tool repairs Windows 10/11 taskbar calendar flyouts and display controls:%u%
echo %c%• Enables ^& starts DisplayEnhancementService (fixes blank/grey brightness slider)%u%
echo %c%• Enables ^& starts SystemEventsBroker (brokers taskbar click and flyout events)%u%
echo %c%• Enables ^& starts TimeBrokerSvc (brokers time, clock, and modern calendar)%u%
echo %c%• Enables ^& starts WpnService ^& WpnUserService (Notification ^& Calendar host)%u%
echo %c%• Clears policies blocking Notification Center or Taskbar Clock%u%
echo %c%• Re-registers ShellExperienceHost package%u%
echo %c%• Restarts Windows Explorer to apply changes immediately%u%
echo.
choice /C YN /M "%c%Apply Taskbar Calendar and Brightness Slider repair? (Y/N)%u%"
if errorlevel 2 goto WindowsMenu
echo.
echo %c%[1/6] Restoring Display Enhancement Service (Brightness Slider)...%u%
sc config DisplayEnhancementService start= demand >nul 2>&1
sc start DisplayEnhancementService >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Services\DisplayEnhancementService" /v "Start" /t REG_DWORD /d "3" /f >nul 2>&1
if "!errorlevel!"=="0" (echo %green%  [+] Done%u%) else (echo %orange%  [!] Failed%u%)

echo.
echo %c%[2/6] Restoring System Events Broker (Taskbar Flyouts)...%u%
sc config SystemEventsBroker start= auto >nul 2>&1
sc start SystemEventsBroker >nul 2>&1
reg add "HKLM\System\CurrentControlSet\Services\SystemEventsBroker" /v "Start" /t REG_DWORD /d "2" /f >nul 2>&1
if "!errorlevel!"=="0" (echo %green%  [+] Done%u%) else (echo %orange%  [!] Failed%u%)

echo.
echo %c%[3/6] Restoring Time Broker Service (Calendar ^& Clock)...%u%
sc config TimeBrokerSvc start= demand >nul 2>&1
sc start TimeBrokerSvc >nul 2>&1
reg add "HKLM\System\CurrentControlSet\Services\TimeBrokerSvc" /v "Start" /t REG_DWORD /d "3" /f >nul 2>&1
if "!errorlevel!"=="0" (echo %green%  [+] Done%u%) else (echo %orange%  [!] Failed%u%)

echo.
echo %c%[4/6] Restoring Windows Push Notification System (Action Center Host)...%u%
sc config WpnService start= auto >nul 2>&1
sc start WpnService >nul 2>&1
reg add "HKLM\System\CurrentControlSet\Services\WpnService" /v "Start" /t REG_DWORD /d "2" /f >nul 2>&1
for /f "tokens=*" %%k in ('reg query "HKLM\SYSTEM\CurrentControlSet\Services" /k /f "WpnUserService" 2^>nul ^| findstr /i "WpnUserService"') do (
    reg add "%%k" /v "Start" /t REG_DWORD /d "3" /f >nul 2>&1
